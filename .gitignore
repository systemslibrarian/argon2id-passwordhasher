# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user

# NuGet
*.nupkg
*.snupkg
.nuget/

# Local NuGet API keys — never commit. Used by `dotnet nuget push` from a
# developer machine. Broad patterns below catch every plausible filename:
# leading-dot, no-dot, .txt extension, typo'd leading-comma, etc.
.nuget-api-key
nuget-api-key
nuget.key
*.nuget-key
*api-key*
*api_key*
*.apikey
.apikeys
,nuget-api-key*
secrets/

# Test results
[Tt]est[Rr]esults/
*.trx
coverage*.json
coverage*.xml
*.coverage

# IDE / editor
.vs/
.vscode/
.idea/
*.swp
*.DS_Store

# DocFx site output (everything under docs/api/ except the hand-written
# index.md and .gitignore — the rest is regenerated by `docfx metadata`).
docs/_site/
docs/api/*.yml
docs/api/*.manifest
