# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user

# NuGet
*.nupkg
*.snupkg
.nuget/

# Local NuGet API keys — never commit. Used by `dotnet nuget push` from a
# developer machine. The intentional repo location is .nuget-api-key at
# the root; the broader patterns below protect against typos and aliases.
.nuget-api-key
nuget-api-key
nuget.key
*.nuget-key
.apikeys
secrets/

# Test results
[Tt]est[Rr]esults/
*.trx
coverage*.json
coverage*.xml
*.coverage

# IDE / editor
.vs/
.vscode/
.idea/
*.swp
*.DS_Store

# DocFx site output (everything under docs/api/ except the hand-written
# index.md and .gitignore — the rest is regenerated by `docfx metadata`).
docs/_site/
docs/api/*.yml
docs/api/*.manifest
