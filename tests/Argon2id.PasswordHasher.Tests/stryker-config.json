{
  "stryker-config": {
    "project": "Argon2id.PasswordHasher.csproj",
    "target-framework": "net10.0",
    "reporters": [ "progress", "html", "markdown" ],
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 60
    },
    "mutation-level": "Standard",
