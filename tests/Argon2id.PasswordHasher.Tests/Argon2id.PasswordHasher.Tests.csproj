<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test fixtures intentionally use weak Argon2 parameters; don't require XML docs here. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Trim / AOT do not apply to a test host. -->
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- CA1707: underscore-separated Method_Scenario_Expectation names are the
         standard, readable convention for xUnit tests. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Argon2id.PasswordHasher/Argon2id.PasswordHasher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit reads this from the output directory at test discovery time. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
