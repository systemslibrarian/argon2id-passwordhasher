<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The demo is a runnable Blazor Server app; pin to net10.0 only. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Argon2id.PasswordHasher.Demo</RootNamespace>
    <AssemblyName>Argon2id.PasswordHasher.Demo</AssemblyName>

    <!-- Sample app — not packed, not trimmed, no XML docs required. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Always use the in-tree library so the demo exercises whatever you're editing. -->
    <ProjectReference Include="..\..\src\Argon2id.PasswordHasher\Argon2id.PasswordHasher.csproj" />
  </ItemGroup>

</Project>
