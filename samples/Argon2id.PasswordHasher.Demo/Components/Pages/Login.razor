@page "/login"
@rendermode InteractiveServer
@inject Argon2idPasswordHasher Hasher
@inject InMemoryUserStore Users
@inject HashingGate Gate
@inject LoginCanary Canary

<PageTitle>Log in — Argon2id.PasswordHasher demo</PageTitle>

<h1>🔓 Log in</h1>

<p class="lede">
    Verification re-runs Argon2id over the stored salt and parameters, then
    compares the candidate tag to the stored tag in constant time. Bad
    passwords and malformed stored values both return <code>false</code>
    &#8212; the library never throws on input. When the username is unknown
    we still run a dummy verify against a canary hash so timing doesn't
    leak which usernames exist.
</p>

<EditForm Model="_input" OnValidSubmit="HandleSubmit" FormName="LoginForm" class="form">
    <DataAnnotationsValidator />

    <div class="form-row">
        <label for="username">Username</label>
        <InputText id="username" @bind-Value="_input.Username" autocomplete="username" maxlength="32" />
        <ValidationMessage For="@(() => _input.Username)" class="validation-message" />
    </div>

    <div class="form-row">
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="_input.Password" autocomplete="current-password" maxlength="256" />
        <ValidationMessage For="@(() => _input.Password)" class="validation-message" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@_busy">
            @if (_busy)
            {
                <span>Verifying&hellip;</span>
            }
            else
            {
                <span>Log in</span>
            }
        </button>
    </div>
</EditForm>

@if (_result is not null)
{
    <div class="callout @(_result.Success ? "callout-success" : "callout-error")">
        @_result.Message
    </div>
}

@if (_storedHash is not null)
{
    <h2>What was compared</h2>
    <p>
        The library re-derived a hash from the password you typed using the
        parameters embedded in the stored string below, then ran
        <code>FixedTimeEquals</code> on the two tag values. Verification took
        <code>~@_elapsedMs ms</code>.
    </p>
    <pre><code>@_storedHash</code></pre>
}

@code {
    private readonly LoginInput _input = new();
    private bool _busy;
    private FormResult? _result;
    private string? _storedHash;
    private long _elapsedMs;

    private async Task HandleSubmit()
    {
        _result = null;
        _storedHash = null;
        _busy = true;

        try
        {
            string username = _input.Username!.Trim();
            string password = _input.Password!;

            DemoUser? user = Users.Find(username);
            string hashToCheck = user?.PasswordHash ?? Canary.Hash;

            // Run verify regardless: when the user does not exist we still
            // burn ~one verify's worth of time so the response is timing-flat.
            var sw = System.Diagnostics.Stopwatch.StartNew();
            bool tagMatched = await Gate.RunAsync(() => Hasher.VerifyPassword(password, hashToCheck));
            sw.Stop();
            _elapsedMs = sw.ElapsedMilliseconds;

            if (user is null || !tagMatched)
            {
                // Generic message regardless of which branch failed —
                // attackers should not learn whether the username exists.
                _result = new(false, "Invalid username or password.");
                return;
            }

            _storedHash = user.PasswordHash;

            // Rehash-on-login: if our defaults have grown since this hash was
            // produced, transparently upgrade it now while we have the plaintext.
            if (Hasher.NeedsRehash(user.PasswordHash))
            {
                string upgraded = await Gate.RunAsync(() => Hasher.HashPassword(password));
                Users.UpdateHash(username, upgraded);
                _result = new(true,
                    $"Welcome back, {username}. Your stored hash was upgraded to the current parameters.");
            }
            else
            {
                _result = new(true, $"Welcome back, {username}.");
            }

            _input.Password = string.Empty;
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class LoginInput
    {
        [Required(ErrorMessage = "Username is required.")]
        [RegularExpression(@"^[A-Za-z0-9._-]{1,32}$",
            ErrorMessage = "Username must be 1–32 characters: letters, digits, dot, underscore, or hyphen.")]
        public string? Username { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(256, MinimumLength = 1,
            ErrorMessage = "Password must be 1–256 characters.")]
        public string? Password { get; set; }
    }

    private sealed record FormResult(bool Success, string Message);
}
