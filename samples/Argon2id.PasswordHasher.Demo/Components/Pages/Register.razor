@page "/register"
@rendermode InteractiveServer
@inject Argon2idPasswordHasher Hasher
@inject InMemoryUserStore Users
@inject HashingGate Gate

<PageTitle>Register — Argon2id.PasswordHasher demo</PageTitle>

<h1>📝 Register a new account</h1>

<p class="lede">
    Submit a username and password. The library will hash the password and
    we'll show you the exact value that would go into a database column.
</p>

<EditForm Model="_input" OnValidSubmit="HandleSubmit" FormName="RegisterForm" class="form">
    <DataAnnotationsValidator />

    <div class="form-row">
        <label for="username">Username</label>
        <InputText id="username" @bind-Value="_input.Username" autocomplete="username" maxlength="32" />
        <ValidationMessage For="@(() => _input.Username)" class="validation-message" />
    </div>

    <div class="form-row">
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="_input.Password" autocomplete="new-password" maxlength="256" />
        <ValidationMessage For="@(() => _input.Password)" class="validation-message" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@_busy">
            @if (_busy)
            {
                <span>Hashing&hellip;</span>
            }
            else
            {
                <span>Register</span>
            }
        </button>
    </div>
</EditForm>

@if (_result is not null)
{
    <div class="callout @(_result.Success ? "callout-success" : "callout-error")">
        @_result.Message
    </div>
}

@if (_lastHash is not null)
{
    <h2>What was stored</h2>
    <p>
        The single string below is everything the library asked us to persist
        for <code>@_lastUsername</code>. The hash takes <code>~@_lastElapsedMs ms</code>
        on this machine with the default secure parameters.
    </p>
    <pre><code>@_lastHash</code></pre>

    @if (PhcBreakdown.TryParse(_lastHash) is { } phc)
    {
        <PhcBreakdownView Breakdown="phc" />
    }
}

@code {
    private readonly RegisterInput _input = new();
    private bool _busy;
    private FormResult? _result;
    private string? _lastHash;
    private string? _lastUsername;
    private long _lastElapsedMs;

    private async Task HandleSubmit()
    {
        _result = null;
        _busy = true;

        try
        {
            // DataAnnotations have already validated shape (length, charset).
            // We still trim the username defensively.
            string username = _input.Username!.Trim();
            string password = _input.Password!;

            if (Users.Exists(username))
            {
                _result = new(false, $"Username '{username}' is already taken.");
                return;
            }

            // Hash off the request thread via the concurrency gate so a flood
            // of registrations can't pin the server on memory.
            var sw = System.Diagnostics.Stopwatch.StartNew();
            string hash = await Gate.RunAsync(() => Hasher.HashPassword(password));
            sw.Stop();

            Users.TryAdd(new DemoUser(username, hash, DateTimeOffset.UtcNow));

            _lastHash = hash;
            _lastUsername = username;
            _lastElapsedMs = sw.ElapsedMilliseconds;
            _result = new(true,
                $"Registered '{username}'. Try logging in, or visit the Registered users page.");

            _input.Password = string.Empty;
            _input.Username = string.Empty;
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class RegisterInput
    {
        [Required(ErrorMessage = "Username is required.")]
        [RegularExpression(@"^[A-Za-z0-9._-]{1,32}$",
            ErrorMessage = "Username must be 1–32 characters: letters, digits, dot, underscore, or hyphen.")]
        public string? Username { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        [StringLength(256, MinimumLength = 1,
            ErrorMessage = "Password must be 1–256 characters.")]
        public string? Password { get; set; }
    }

    private sealed record FormResult(bool Success, string Message);
}
