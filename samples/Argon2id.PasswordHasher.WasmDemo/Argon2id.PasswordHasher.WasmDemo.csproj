<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- Blazor WebAssembly is hosted as a single-page app; pin to net10.0. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Argon2id.PasswordHasher.WasmDemo</RootNamespace>
    <AssemblyName>Argon2id.PasswordHasher.WasmDemo</AssemblyName>

    <!-- Sample app — not packed, not trimmed (Konscious has not been audited
         for trim-safety in WASM and reliability wins over a smaller download
         for a demo). -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Keep the publish output simple. The Pages workflow rewrites the base
         href post-publish; <StaticWebAssetBasePath> is left at the default so
         local `dotnet run` works at the root URL. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>

    <!-- Enable multi-threaded WASM so hashing can run on a worker thread instead
         of freezing the UI for ~2 seconds. The cross-origin-isolation headers
         the browser requires (COOP: same-origin, COEP: require-corp) are
         injected by wwwroot/coi-serviceworker.js, which makes this work on
         GitHub Pages (where we can't set response headers directly). -->
    <WasmEnableThreads>true</WasmEnableThreads>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Always use the in-tree library so the demo exercises whatever you're editing. -->
    <ProjectReference Include="..\..\src\Argon2id.PasswordHasher\Argon2id.PasswordHasher.csproj" />
  </ItemGroup>

</Project>
