<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Argon2id.PasswordHasher.AspNetCore</RootNamespace>
    <AssemblyName>Argon2id.PasswordHasher.AspNetCore</AssemblyName>

    <!-- NuGet package identity -->
    <PackageId>Argon2id.PasswordHasher.AspNetCore</PackageId>
    <Version>0.2.0-preview.1</Version>
    <Description>ASP.NET Core Identity integration for Argon2id.PasswordHasher. Provides an IPasswordHasher&lt;TUser&gt; implementation backed by secure-by-default Argon2id, with automatic rehash-on-login (PasswordVerificationResult.SuccessRehashNeeded) and a one-line AddArgon2idPasswordHasher DI extension.</Description>
    <PackageTags>argon2;argon2id;password;hashing;aspnetcore;identity;ipasswordhasher;security;cryptography</PackageTags>

    <!-- Licensing -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/systemslibrarian/argon2id-passwordhasher</PackageProjectUrl>

    <!-- SourceLink + symbols -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Argon2id.PasswordHasher/Argon2id.PasswordHasher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
