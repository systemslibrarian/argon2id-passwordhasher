<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Argon2id.PasswordHasher.AspNetCore</RootNamespace>
    <AssemblyName>Argon2id.PasswordHasher.AspNetCore</AssemblyName>

    <!-- NuGet package identity -->
    <PackageId>Argon2id.PasswordHasher.AspNetCore</PackageId>
    <Title>Argon2id.PasswordHasher.AspNetCore — IPasswordHasher&lt;TUser&gt; adapter for ASP.NET Core Identity</Title>
    <Description>ASP.NET Core Identity integration for Argon2id.PasswordHasher. Provides an IPasswordHasher&lt;TUser&gt; implementation backed by secure-by-default Argon2id, with automatic rehash-on-login (PasswordVerificationResult.SuccessRehashNeeded) and a one-line AddArgon2idPasswordHasher DI extension. Targets .NET 8, 9, and 10.</Description>
    <PackageTags>argon2;argon2id;password;hashing;aspnetcore;identity;ipasswordhasher;security;cryptography;aot</PackageTags>
    <PackageReleaseNotes>See https://github.com/systemslibrarian/argon2id-passwordhasher/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- Licensing -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/systemslibrarian/argon2id-passwordhasher</PackageProjectUrl>

    <!-- SourceLink + symbols -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Validate the package at pack time (TFM compatibility, baseline API).
         Bump the baseline to the newest published version after each release;
         an intentional break must bump it consciously in the same PR. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.4.0-preview.5</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.11.0-beta1.24415.1" PrivateAssets="All" />
  </ItemGroup>

  <!-- Per-TFM floor of Microsoft.Extensions.Identity.Core. Each runtime gets the
       matching major version, so consumers can upgrade without forced overrides. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Argon2id.PasswordHasher/Argon2id.PasswordHasher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
