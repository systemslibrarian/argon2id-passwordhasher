<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Argon2id.PasswordHasher</RootNamespace>
    <AssemblyName>Argon2id.PasswordHasher</AssemblyName>

    <!-- NuGet package identity -->
    <PackageId>Argon2id.PasswordHasher</PackageId>
    <Title>Argon2id.PasswordHasher — Secure-by-default Argon2id password hashing for .NET</Title>
    <Description>An opinionated, secure-by-default Argon2id password hashing library for .NET 8, 9, and 10. Provides memory-hard protection against GPU/ASIC attacks with RFC 9106 / OWASP-aligned parameters, a self-describing PHC hash string format, constant-time verification, optional keyed pepper with rotation, and a clean HashPassword / VerifyPassword API designed for ASP.NET Core Identity and user registration. Trim- and Native-AOT-compatible.</Description>
    <PackageTags>argon2;argon2id;password;hashing;password-hashing;cryptography;security;phc;owasp;rfc9106;identity;aspnetcore;aot</PackageTags>
    <PackageReleaseNotes>See https://github.com/systemslibrarian/argon2id-passwordhasher/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- Licensing -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/systemslibrarian/argon2id-passwordhasher</PackageProjectUrl>

    <!-- SourceLink + symbols for debuggable, transparent packages -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Validate the package at pack time (TFM compatibility, baseline API).
         Bump the baseline to the newest published version after each release;
         an intentional break must bump it consciously in the same PR. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.4.0-preview.5</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Internal PHC parser is exercised directly by the test + fuzz harnesses. -->
    <InternalsVisibleTo Include="Argon2id.PasswordHasher.Tests" />
    <InternalsVisibleTo Include="Argon2id.PasswordHasher.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" Visible="false" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
