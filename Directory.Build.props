<Project>

  <!--
    Shared MSBuild properties for every project in the repository.
    Keeps packaging, language, and build-quality settings in one place.
  -->

  <PropertyGroup>
    <!-- Language / runtime -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Engineering discipline: warnings are errors, full analysis on -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Deterministic, reproducible builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Trim + Native AOT readiness for packable assemblies. Test and benchmark
         projects opt out by clearing these in their csproj. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Build-time vulnerability scanning of every dependency, direct + transitive. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- Single source of truth for package version. -->
    <Version>0.3.0-preview.1</Version>

    <!-- Shared author / repository metadata -->
    <Authors>Paul Clark</Authors>
    <Company>Paul Clark</Company>
    <Product>Argon2id.PasswordHasher</Product>
    <Copyright>Copyright (c) Paul Clark</Copyright>
    <RepositoryUrl>https://github.com/systemslibrarian/argon2id-passwordhasher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
