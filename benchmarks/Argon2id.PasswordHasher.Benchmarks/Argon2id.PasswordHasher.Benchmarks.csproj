<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- BenchmarkDotNet only needs a single host TFM. Pin to net10 (the SDK we build with). -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Argon2id.PasswordHasher.Benchmarks</RootNamespace>
    <AssemblyName>Argon2id.PasswordHasher.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- BenchmarkDotNet requires public [Params] fields (CA1051). -->
    <NoWarn>$(NoWarn);CA1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Argon2id.PasswordHasher/Argon2id.PasswordHasher.csproj" />
  </ItemGroup>

</Project>
